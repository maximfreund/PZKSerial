{
  "name": "pilzkultursound",
  "description": "PilzkulturSound: standalone Wi-Fi remote for the Behringer Ultradrive Pro (DCX2496). Fork of DuinoDCX.",
  "version": "0.1.0",
  "private": true,
  "author": "Lasse Lukkari <lasse.lukkari@gmail.com>",
  "contributors": [
    "Ilkka Huhtakallio"
  ],
  "repository": "github:maximfreund/PZKSerial",
  "license": "MIT",
  "brand": {
    "name": "PilzkulturSound",
    "releasesRepo": "maximfreund/PZKSerial"
  },
  "devDependencies": {
    "awot-scripts": "0.0.38"
  },
  "dependencies": {
    "dcx-ui": "0.0.11"
  },
  "scripts": {
    "build": "node scripts/brand-ui.js && awot-static",
    "compile": "arduino-cli compile --fqbn esp32:esp32:esp32:PartitionScheme=min_spiffs --output-dir build/firmware DuinoDCX"
  },
  "awot-static": {
    "sources": "./build/ui",
    "indexFile": "index.html",
    "sketchDir": "./DuinoDCX",
    "exclude": [
      "*.map",
      "service-worker.js"
    ]
  },
  "renovate": {
    "extends": [
      "config:base"
    ]
  }
}
